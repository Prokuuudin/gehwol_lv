# Document root config (Apache). Copied to docs/.htaccess by `gulp templates:docs`.
# Existing files (css, js, img, legal pages, admin) are served as is; every other request
# goes to php/site.php, which renders products, categories, news, articles, the home page,
# sitemap.xml and the 404 page from php/data/*.json.

Options -Indexes

RewriteEngine On
# Short admin address: /admin and /admin/ -> /php/admin/ (302, so browsers do not cache it forever)
RewriteRule ^admin/?$ /php/admin/ [R=302,L]
RewriteRule ^$ php/site.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ php/site.php [L]

# Never serve dotfiles (except .well-known), PHP settings, logs or documents (php/data has its own deny)
RewriteRule (^|/)\.(?!well-known/) - [F]
<FilesMatch "\.(lock|tmp|log|md|ini|bak|sql|docx?)$">
    Require all denied
</FilesMatch>

# PHP settings when PHP runs as an Apache module (PHP-FPM reads .user.ini instead)
<IfModule mod_php.c>
    php_flag display_errors Off
    php_value upload_max_filesize 10M
    php_value post_max_size 64M
    php_value max_file_uploads 20
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_value upload_max_filesize 10M
    php_value post_max_size 64M
    php_value max_file_uploads 20
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always unset X-Powered-By
    Header unset X-Powered-By
    # HTTPS only, for a year. Checked 2026-09-29: Let's Encrypt covers gehwol.lv and www.gehwol.lv,
    # http:// and www redirect to https://gehwol.lv. No includeSubDomains (mail/webmail may lack HTTPS).
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
